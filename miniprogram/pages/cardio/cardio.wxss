.page {
  padding: 24rpx;
}

.period-toggle {
  display: flex;
  gap: 16rpx;
}

.period-btn {
  flex: 1;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  background: #f1f5f9;
  color: #475569;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
}

.period-btn.active {
  background: #ecfeff;
  color: #0e7490;
  border-color: #0e7490;
  font-weight: 600;
}

.picker-value {
  display: flex;
  align-items: center;
}

.summary-copy {
  margin-top: 20rpx;
}

.range-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.range-btn {
  flex: 1;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  background: #f1f5f9;
  color: #475569;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
}

.range-btn.active {
  background: #ecfeff;
  color: #0e7490;
  border-color: #0e7490;
  font-weight: 600;
}

.toggle-charts {
  margin-bottom: 20rpx;
}

.list-title {
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}
